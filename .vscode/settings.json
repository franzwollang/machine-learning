{
	// Force LaTeX Workshop to use TeX Live 2025 binaries explicitly
	"latex-workshop.latex.tools": [
		{
			"name": "latexmk",
			"command": "/usr/local/texlive/2025/bin/universal-darwin/latexmk",
			"args": [
				"-synctex=1",
				"-interaction=nonstopmode",
				"-file-line-error",
				"-pdf",
				"%DOC%"
			]
		},
		{
			"name": "pdflatex",
			"command": "/usr/local/texlive/2025/bin/universal-darwin/pdflatex",
			"args": [
				"-synctex=1",
				"-interaction=nonstopmode",
				"-file-line-error",
				"%DOC%"
			]
		},
		{
			"name": "bibtex",
			"command": "/usr/local/texlive/2025/bin/universal-darwin/bibtex",
			"args": ["%DOCFILE%"]
		},
		{
			"name": "biber",
			"command": "/usr/local/texlive/2025/bin/universal-darwin/biber",
			"args": ["%DOCFILE%"]
		}
	],
	"latex-workshop.latex.recipes": [
		{
			"name": "latexmk",
			"tools": ["latexmk"]
		},
		{
			"name": "pdflatex ➞ bibtex ➞ pdflatex×2",
			"tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
		},
		{
			"name": "pdflatex ➞ biber ➞ pdflatex×2",
			"tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
		}
	],
	// Ensure LaTeX Workshop sees the PATH that includes /Library/TeX/texbin as fallback
	"latex-workshop.latex.path": "/usr/local/texlive/2025/bin/universal-darwin:/Library/TeX/texbin:/usr/local/bin:/usr/bin:/bin",
	// Enable continuous building on save
	"latex-workshop.latex.autoBuild.run": "onFileChange",
	// Use synctex for forward/inverse search
	"latex-workshop.synctex.afterBuild.enabled": true,
	// Use PdfLaTeX as default engine unless file specifies otherwise
	"latex-workshop.latex.outDir": "./",
	// Silence recipe selection prompt
	"latex-workshop.latex.recipe.default": "first",

	// VS Code explorer: nest LaTeX aux/log/etc. files under their .tex parent
	"explorer.fileNesting.enabled": true,
	// Keep nested LaTeX files collapsed by default
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"*.tex": "${capture}.aux, ${capture}.log, ${capture}.out, ${capture}.fdb_latexmk, ${capture}.fls, ${capture}.synctex.gz, ${capture}.toc, ${capture}.bbl, ${capture}.blg, ${capture}.nav, ${capture}.snm, ${capture}.vrb, ${capture}.lof, ${capture}.lot"
	}
}
